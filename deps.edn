;; Canonical Studio dependency data, also consumed by project.clj.
;; Tests never start physical output.
{:paths ["src" "src/shared" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        com.cognitect/transit-clj {:mvn/version "1.2.372"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        thi.ng/color {:mvn/version "1.5.1" :exclusions [org.clojure/clojurescript]}
        org.slf4j/slf4j-api {:mvn/version "2.0.20"}
        commons-codec/commons-codec {:mvn/version "1.23.0"}
        org.deepsymmetry/beat-link {:mvn/version "8.0.0"}
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        tolgraven/afterglow {:local/root "../afterglow"}}
 :aliases {:run {:main-opts ["-m" "tolglow.application"]}
           :studio {:main-opts ["-m" "tolglow.application"]}
           :cljs {:replace-paths ["src/studio" "src/shared" "resources"]
                  :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.14"}
                               metosin/reitit-frontend {:mvn/version "0.11.0"}
                               com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                               re-frame/re-frame {:mvn/version "1.4.7"}
                               reagent/reagent {:mvn/version "2.0.1"}}}
           :check-roadmap {:extra-paths ["dev"]
                          :main-opts ["-m" "tolglow.check-roadmap"]}
           :test {:extra-paths ["test" "dev"]
                  :jvm-opts ["-Djava.awt.headless=true"]
                  :main-opts ["-m" "tolglow.test-runner"]}}}
