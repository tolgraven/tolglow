#!/usr/bin/env python3
"""Show the independent review receipts and discussions for a GitHub PR."""
import argparse
import json
import re
import subprocess
import sys

def api(*args):
    return json.loads(subprocess.check_output(["gh", "api", *args], text=True))

def pages(endpoint):
    return [row for page in api("--paginate", "--slurp", endpoint) for row in page]

def threads(owner, repo, number):
    query = """query($owner:String!,$repo:String!,$number:Int!,$cursor:String) {
      repository(owner:$owner,name:$repo){pullRequest(number:$number){
        reviewThreads(first:100,after:$cursor){nodes{
          isResolved isOutdated comments(first:1){nodes{url author{login} body}}
        }pageInfo{hasNextPage endCursor}}
      }}}"""
    cursor = None
    while True:
        args = ["graphql", "-f", "query="+query, "-f", "owner="+owner, "-f", "repo="+repo, "-F", "number="+str(number)]
        if cursor:
            args += ["-f", "cursor="+cursor]
        result = api(*args)["data"]["repository"]["pullRequest"]["reviewThreads"]
        yield from result["nodes"]
        if not result["pageInfo"]["hasNextPage"]:
            return
        cursor = result["pageInfo"]["endCursor"]

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("repo", help="owner/repository")
    parser.add_argument("number", type=int)
    args = parser.parse_args()
    owner, repo = args.repo.split("/", 1)
    path = f"repos/{args.repo}"
    pr = f"{path}/pulls/{args.number}"
    data = api(pr)
    head = data["head"]["sha"]
    print(f"{data['html_url']}  {head}")
    requested = [r["login"] for r in data["requested_reviewers"]] + [r["slug"] for r in data["requested_teams"]]
    print("Review requests pending:", ", ".join(requested) or "none")
    comments = pages(f"{path}/issues/{args.number}/comments")
    reviews = pages(pr+"/reviews")
    receipt = None
    for c in comments:
        match = re.search(r"<!-- codex-review-state:v1 (.*?) -->", c["body"])
        if match and c["user"]["login"] == "chatgpt-codex-connector[bot]":
            review = json.loads(match[1]).get("code_review") or {}
            print("Codex receipt:", review.get("status"), review.get("commit_sha"), c["html_url"])
            if review.get("commit_sha") == head:
                receipt = review
        else:
            print("PR comment:", c["user"]["login"], c["html_url"])
    for review in reviews:
        print("Review:", review["user"]["login"], review["state"], review.get("commit_id"), review["html_url"])
    open_threads = []
    for thread in threads(owner, repo, args.number):
        if not thread["isResolved"]:
            c = thread["comments"]["nodes"][0]
            open_threads.append(c["url"])
            print("Open discussion:", c["author"]["login"] if c["author"] else "deleted user",
                  "(older diff)" if thread["isOutdated"] else "", c["url"])
    print("Unresolved discussions:", len(open_threads))
    # Human disposition of each linked discussion is still needed even when stale.
    return 0 if receipt and receipt.get("status") == "completed" and not open_threads and not requested else 1

if __name__ == "__main__":
    sys.exit(main())
