#!/usr/bin/env bash
# Complete mixed rig (dimmers, RGB pars, RGBW pixels, pan/tilt heads, many cues,
# LFO modulation) through show/tick! with an ArtDMX capture. No network output.
set -euo pipefail
cd "$(dirname "$0")/.."
afterglow_profile_root=$(cd "${AFTERGLOW_ROOT:-../afterglow}" && pwd)
export AFTERGLOW_ROOT="$afterglow_profile_root"
exec lein with-profile +benchmark run -m tolglow.perf.mixed-rig "$@"
