#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if (( $# > 2 )); then echo "usage: bin/profile-mover-shader [heads=64] [frames=80]" >&2; exit 2; fi
heads="${1:-64}"
frames="${2:-80}"
oracle="$(mktemp)"
trap 'rm -f "$oracle"' EXIT
lein run -m tolglow.mover-oracle "$heads" "$frames" > "$oracle"
node dev/gpu/profile-movers.cjs "$oracle"
