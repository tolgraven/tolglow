{
  "schema": "tolglow-agent-act/1",
  "basis": {"obs": "o-0413", "rev": 1844},
  "note": "Breakdown detected a phrase early: drop the lift, go dark and slow, keep the human's wash.",
  "cancel": [
    {"intent": "lift"}
  ],
  "post": [
    {
      "group": "g-break",
      "intent": ["breakdown", "section:break"],
      "rank": 1,
      "on_failure": "cancel-rest",
      "until": {"bar": 40},
      "check": "continuous",
      "guard": [
        {"var": "audio/energy", "op": "lt", "value": 0.6},
        {"no_event": "audio/breakdown-end", "since": "post"}
      ],
      "events": [
        {"id": "br-dim", "op": "param/ramp", "target": "opacity",
         "select": {"categories": ["intensity"], "pick": "all"},
         "to": 0.35, "over": {"bars": 2}, "curve": "ease-out", "grid": {"bars": 1}},
        {"id": "br-chase-out", "op": "instance/end", "instance-id": "2:22", "grid": {"bars": 1}},
        {"id": "br-breath", "op": "cue/launch", "cue-id": "breath",
         "launch": {"mode": "persistent", "params": {"level": 0.3, "period": 4}}, "grid": {"bars": 1}},
        {"id": "br-narrow", "op": "param/ramp", "instance-id": "2:21", "param": "width",
         "to": 1.5, "over": {"bars": 4}, "curve": "smoothstep", "grid": {"bars": 1}}
      ]
    },
    {
      "group": "g-return",
      "intent": ["return", "section:c"],
      "rank": 0,
      "check": "due",
      "guard": [
        {"var": "audio/energy", "op": "gte", "value": 0.5},
        {"budget": {"max_lit": 8}}
      ],
      "events": [
        {"id": "ret-wash", "op": "param/ramp", "target": "opacity",
         "select": {"categories": ["intensity"], "pick": "all"},
         "to": 1.0, "over": {"beats": 2}, "curve": "ease-in", "at": {"bar": 36}},
        {"id": "ret-chase", "op": "cue/launch", "cue-id": "chase",
         "launch": {"mode": "persistent", "params": {"drive": 1.2}}, "at": {"bar": 36}}
      ]
    }
  ]
}
