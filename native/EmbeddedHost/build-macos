#!/usr/bin/env bash
set -euo pipefail
: "${JAVA_HOME:?Use the GraalVM Community JDK with Native Image}"
root="$(cd "$(dirname "$0")/../.." && pwd)"
jar="${1:?Studio jar compiled with the embedded-host profile}"
build="${2:?An empty build directory}"
mkdir -p "$build"
cp "$jar" "$build/studio.jar"
cd "$build"
export PATH="$JAVA_HOME/bin:$PATH"
"$root/native/EmbeddedHost/prepare-jar" macos
curl -fLsS --retry 3 https://repo.maven.apache.org/maven2/io/github/willena/sqlite-jdbc/3.49.0.0/sqlite-jdbc-3.49.0.0.jar -o sqlite.jar
echo '8240639e54a1270fbc11cd56b5f5f0d0ea4aab839a9b80c791978aef4522e01e  sqlite.jar' | shasum -a 256 -c -
# The image builder keeps about 4 GB live from analysis to layout. A hosted
# macos-15 runner has 7.5 GB, so the builder's default heap (75% of RAM) plus
# about 1.2 GB outside the heap swaps, and one post-analysis phase then outlasts
# the 10-minute deadlock watchdog. Keep the heap inside physical memory and give
# the old generation room for the live set: ParallelGC otherwise caps it at two
# thirds of the heap and runs out during layout.
heap="${TOLGLOW_NATIVE_IMAGE_HEAP:-5g}"
# Report the builder's memory and the machine's swap once a minute, so a slow
# phase shows whether it is paging rather than deadlocked.
(
  start=$SECONDS
  while sleep 60; do
    rss=$(ps -axo rss=,command= | awk -v java="$JAVA_HOME/bin/java" 'index($0, java) {kb += $1} END {printf "%.2f", kb / 1048576}')
    echo "[build-macos] $(( (SECONDS - start) / 60 )) min: builder RSS ${rss} GB, swap $(sysctl -n vm.swapusage | sed -E 's/.*used = ([^ ]+).*/\1/') used"
  done
) &
heartbeat=$!
trap 'kill "$heartbeat" 2>/dev/null || true' EXIT
native-image --no-fallback -J-Dtolglow.native.build=true \
  "-J-Xmx$heap" -J-XX:NewRatio=6 \
  --initialize-at-build-time=com.cognitect.transit.impl,com.fasterxml.jackson.core.JsonToken \
  --features=clj_easy.graal_build_time.InitClojureClasses --enable-url-protocols=http,https,jar \
  -H:+UnlockExperimentalVMOptions -H:DeadlockWatchdogInterval=30 \
  -H:IncludeResourceBundles=jakarta.servlet.LocalStrings,jakarta.servlet.http.LocalStrings \
  -H:IncludeResources='studio/.*|gpu/.*|js/compute/.*|.*\.edn|.*\.clj[cs]?' \
  -H:-UnlockExperimentalVMOptions \
  -cp sqlite.jar:studio.jar:graal-build-time.jar -o TolglowNativeHost tolglow.native.desktop 2>&1 | tee native-build.log
