#!/usr/bin/env python3
"""Emit the AASA document for the bundle identifiers in native/project.yml."""

import argparse
import json
import re


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("app_id_prefix", help="signed app identifier prefix (usually the Team ID)")
    prefix = parser.parse_args().app_id_prefix
    if not re.fullmatch(r"[A-Z0-9]{10}", prefix):
        parser.error("expected the 10-character app identifier prefix from your signing team")
    phone = f"{prefix}.se.tolgraven.tolglow.ios"
    print(json.dumps({
        "appclips": {"apps": [f"{phone}.Clip"]},
        "applinks": {"details": [{
            "appIDs": [phone], "components": [{"/": "/audience/*"}],
        }]},
    }, indent=2))


if __name__ == "__main__":
    main()
