{
  "name": "tolglow-studio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio:build": "npm run preview:build && shadow-cljs release studio",
    "studio:dev": "shadow-cljs watch studio",
    "studio:check": "shadow-cljs compile studio",
    "studio:test": "shadow-cljs compile studio-test && node -r ./dev/studio-node-globals.cjs target/studio-tests.js",
    "preview:build": "node js/preview/build.mjs",
    "preview:test": "node --test --test-concurrency=1 test/js/preview/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/motion": "8.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "mediabunny": "1.66.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "shadow-cljs": "3.5.14"
  }
}
